<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/gradient_bg">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CITY CIVIC"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@android:color/black" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Reporting and Management App for Real-Time City Issues"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:background="@drawable/circle_bg"
            android:elevation="6dp"
            android:layout_gravity="center" />

        <!-- BUTTON ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="25dp">

            <Button
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Report Issue"
                android:textColor="#fff"
                android:backgroundTint="#c10a0a"
                android:layout_margin="6dp" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Map"
                android:textColor="#fff"
                android:backgroundTint="#0071c5"
                android:layout_margin="6dp" />

            <Button
                android:id="@+id/btnTimetable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Timetable"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:backgroundTint="#ffdf00"
                android:layout_margin="6dp" />

        </LinearLayout>

        <!-- BUTTON ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CivicBot"
                android:textColor="#fff"
                android:backgroundTint="#08a045"
                android:layout_margin="6dp" />

            <Button
                android:id="@+id/btnIssues"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Issues"
                android:textColor="#fff"
                android:backgroundTint="#7400ab"
                android:layout_margin="6dp" />

            <Button
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coordination Chat"
            android:textColor="@android:color/white"
            android:backgroundTint="#6D4C41"
            android:textSize="12sp"
            android:layout_margin="6dp" />

        </LinearLayout>

        <!-- ================= ABOUT SECTION (ORANGE CARD) ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#FFF3E0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About Maharashtra"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kolhapur is a historic and culturally rich city of Maharashtra known for its heritage, temples, and development initiatives.Under the guidance of Chhatrapati Shahu Maharaj, Kolhapur became one of the most deveeloped and forward-thinking cities of India. We can see how the mindset of Kolhapuri people regarding environment,humanity,womene's rights have been more progressive than many others.Truly the city of lakes has a stunning bounty of nature, well-preserved heritage like Kolhapuri Chappals and historical temples like the Mahalakshmi Mandir and lets not forget the mouth-watering cuisine with fiery dishes such as Tambda-Pandhara rassa,Mango Cocktail Icecream and Misal Pav."
                    android:layout_marginTop="6dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/mahalakshmi"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/panhala"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sadly, many cities including Kolhapur have reduced their quality of living due to road,disaster problems and most importantly, lack of civic sense among individuals.Issues in the city include waste management, road maintenance, and water supply systems."
                    android:layout_marginTop="10dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/kachra"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pipe" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reporting issues through this app ensures faster resolution and better governance. KolhapurCivic uniquely uses smart and up to date features to report various civic issues and also we can see status of various issues and prioritise accordingly. It will also foster civic sense, awareness and governmental support among people and communities."
                    android:layout_marginTop="10dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/report"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo1" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= FOUNDERS (YELLOW CARDS) ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Founders"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <!-- Founder1 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:background="#FFFDE7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Anjali Wadekar (CEO)"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Anjali Wadekar is a software engineer who's passionate about developing sustainable solutions to make India a better place."
                     />

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/founder1"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Founder2 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:background="#FFFDE7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pranav Mane"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pranav Mane is a software developer who likes to create interactive solutions and work on core databases."
                     />

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/founder2"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Founder2 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:background="#FFFDE7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sahil Kamble (CMO)"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sahil Kamble is a software developer who likes to develop and learn about new technological and trending things."
                     />

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/founder3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Guide Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:background="#FFFDE7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mrs Sonal Ayare"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dr. Sonal Ayare is an assistant professor in CSE Department of KITCOEK. She is a passionate leader who guides with responsibility and grace. Her expertise are project management and app development."
                    />

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/guide"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <!-- ================= CONTACT CARDS ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:background="#FFF3E0"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📞 Contact Departments"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➜"
                    android:textSize="24sp"
                    android:textColor="#E65100"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© Kolhapur Civic 2026"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>